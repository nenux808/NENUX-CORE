# ==========================================
# NENUX CORE - Git Ignore
# ==========================================

# Python virtual environment
.venv/
venv/
env/

# Python cache / compiled files
__pycache__/
*.py[cod]
*.class

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE / editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# NENUX runtime databases / local memory
memory/*.db
memory/*.db-shm
memory/*.db-wal

# Logs
*.log

# Temporary files
*.tmp
*.temp

# NENUX live agent workspace
workspace/
